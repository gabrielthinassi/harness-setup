# URL da API .NET (acessada SOMENTE pelo servidor Next/BFF; nunca exposta ao navegador)
BACKEND_API_URL=https://localhost:7100

# Chave de 32 bytes em base64 para criptografar o cookie de sessão
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Provedor OIDC (Keycloak, Entra ID, Auth0...)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
APP_URL=http://localhost:3000
